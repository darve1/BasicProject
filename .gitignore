# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# 로컬 개발 도구(설치한 디자인 스킬·에이전트·MCP 설정). 남의 저작물이 섞여 있어 공개 저장소에 올리지 않는다
/.claude/
/.mcp.json

# impeccable decision mocks
/.impeccable/mocks/

# 아티팩트 미리보기 결과물
/.artifact/

# 디자인 도구의 캐시·선택 화면 상태 (디자인 기록 design.json, surfaces/ 는 올린다)
/.impeccable/hook.cache.json
/.impeccable/decision-payload.json
