      "html": "<header class=\"ds-top\"><b>구독<span>장부</span></b><nav><a aria-current=\"page\">홈</a><a>최저가</a><a>할인</a></nav><small>내 조건 <b>SKT · 신한카드 외 3</b></small></header>",
      "css": ".ds-top{display:flex;align-items:stretch;gap:28px;height:56px;padding:0 20px;background:#fff;border-bottom:1px solid var(--rule,#dfe3dc);font-size:15px;width:640px}.ds-top>b{align-self:center}.ds-top>b span{color:var(--red,#c4313a)}.ds-top nav{display:flex;gap:22px}.ds-top nav a{display:flex;align-items:center;border-bottom:2px solid transparent;color:var(--ink-2,#444d5b)}.ds-top nav a[aria-current]{border-color:var(--ink,#1d2430);color:var(--ink,#1d2430);font-weight:700}.ds-top small{margin-left:auto;align-self:center;color:var(--ink-3,#5c6470);font-size:13px}.ds-top small b{color:var(--ink,#1d2430)}"
