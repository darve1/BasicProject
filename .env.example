# 복사해서 .env.local 로 만들고 값을 채우세요. .env.local 은 git에 올라가지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 크롤러·시드 스크립트 전용. 브라우저 코드에서 절대 쓰지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# 마이그레이션 스크립트 전용 (Connect > Session pooler)
SUPABASE_DB_URL=
